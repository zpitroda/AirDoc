# AirDoc Environment Configuration

# Administrative Portal Authentication (Required)
# Accessible only at /admin - No public navigation links exist
ADMIN_PASSWORD=airdoc2026!
SESSION_SECRET=airdoc-secret-token-key-2026-purdue-locums

# Founder / Administrator Notifications
ADMIN_NOTIFICATION_EMAIL=founders@airdochealth.com
EMAIL_FROM="AirDoc Founders" <founders@airdochealth.com>

# Professional Email Dispatch - Option 1: Hostinger Business / Webmail SMTP
# (You can use your existing founders@airdochealth.com mailbox - no extra mailbox needed!)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=founders@airdochealth.com
SMTP_PASS=your_founders_mailbox_password
SMTP_SECURE=true

# (If your Hostinger email uses Titan Email instead of Hostinger Webmail, set:
# SMTP_HOST=smtp.titan.email)

# Professional Email Dispatch - Option 2: Resend API (Alternative)
# RESEND_API_KEY=re_your_resend_api_key

# In local development without RESEND_API_KEY or SMTP credentials,
# the system automatically logs formatted email dispatches with simulated IDs.
